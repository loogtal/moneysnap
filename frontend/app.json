{
  "expo": {
    "name": "MoneySnap",
    "slug": "moneysnap",
    "version": "1.0.0",
    "sdkVersion": "56.0.0",
    "scheme": "moneysnap",
    "platforms": [
      "ios",
      "android"
    ],
    "assetBundlePatterns": [
      "**/*"
    ],
    "orientation": "portrait",
    "extra": {
      "eas": {
        "projectId": "bfda7744-0124-4b9f-944c-6dae3813b6eb"
      }
    },
    "android": {
      "package": "com.liserosaliz.moneysnap",
      "googleServicesFile": "./google-services.json"
    },
    "ios": {
      "bundleIdentifier": "com.liserosaliz.moneysnap",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-web-browser",
      "expo-apple-authentication",
      "expo-sharing",
      "expo-notifications"
    ]
  }
}
